 #[cfg(feature = "minisat")]
 pub mod minisat;
 
+// Compatibility alias used by maxsattrainscheduling. Its SAT-DDD routines
+// create their native RustSAT solver internally; the generic argument is not
+// used. Keeping the alias here lets the workspace type-check with upstream
+// salvers.
+#[cfg(feature = "solver_rustsat_glucose")]
+pub mod rustsat_glucose {
+    pub use super::minisat::Solver;
+}
+
+#[cfg(feature = "solver_rustsat_glucose")]
+impl crate::Var for ::rustsat::types::Var {}
+
+#[cfg(feature = "solver_rustsat_glucose")]
+impl crate::Lit for ::rustsat::types::Lit {
+    type Var = ::rustsat::types::Var;
+
+    fn into_var(self) -> (Self::Var, bool) {
+        (self.var(), self.is_neg())
+    }
+
+    fn from_var_sign(variable: Self::Var, sign: bool) -> Self {
+        variable.lit(sign)
+    }
+}
+
 #[cfg(feature = "cadical")]
 pub mod cadical;
 
