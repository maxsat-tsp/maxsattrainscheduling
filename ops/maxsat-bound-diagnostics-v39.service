[Unit]
Description=Diagnose SAT optimal-cost feasibility and optimality proof using audited Big-M optima
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/home/tuyenkv/projects/bound-diagnostics-v39/results/aglr/bound-diagnostics-v39-20261109/COMPLETED
ConditionPathExists=!/home/tuyenkv/projects/bound-diagnostics-v39/results/aglr/bound-diagnostics-v39-20261109/FAILED
ConditionPathExists=!/home/tuyenkv/projects/bound-diagnostics-v39/results/aglr/bound-diagnostics-v39-20261109/INCOMPLETE

[Service]
Type=simple
User=tuyenkv
WorkingDirectory=/home/tuyenkv/projects/bound-diagnostics-v39
EnvironmentFile=/home/tuyenkv/.config/maxsat/bound-diagnostics-v39.env
ExecStart=/usr/bin/taskset -c 0,1,4,5 /bin/bash /home/tuyenkv/projects/bound-diagnostics-v39/ops/run_bound_diagnostics_v39.sh
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30
RuntimeMaxSec=21600
