ConditionPathExists=!/home/tuyenkv/projects/sat-bound-search-v41/results/aglr/sat-bound-search-v41-20261109/INCOMPLETE

[Service]
Type=simple
User=tuyenkv
WorkingDirectory=/home/tuyenkv/projects/sat-bound-search-v41
EnvironmentFile=/home/tuyenkv/.config/maxsat/sat-bound-search-v41.env
ExecStart=/usr/bin/taskset -c 0,1,4,5 /bin/bash /home/tuyenkv/projects/sat-bound-search-v41/ops/run_sat_bound_search_v41.sh
