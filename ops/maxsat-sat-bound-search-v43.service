[Unit]
Description=RC2 warmup with strict-improvement SAT search on eleven unresolved V42 pairs
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/home/tuyenkv/projects/sat-bound-search-v43/results/aglr/sat-bound-search-v43-20261110/COMPLETED
ConditionPathExists=!/home/tuyenkv/projects/sat-bound-search-v43/results/aglr/sat-bound-search-v43-20261110/FAILED
ConditionPathExists=!/home/tuyenkv/projects/sat-bound-search-v43/results/aglr/sat-bound-search-v43-20261110/INCOMPLETE

[Service]
Type=simple
User=tuyenkv
WorkingDirectory=/home/tuyenkv/projects/sat-bound-search-v43
EnvironmentFile=/home/tuyenkv/.config/maxsat/sat-bound-search-v43.env
ExecStart=/usr/bin/taskset -c 0,1,4,5 /bin/bash /home/tuyenkv/projects/sat-bound-search-v43/ops/run_sat_bound_search_v43.sh
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30
RuntimeMaxSec=21600
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
