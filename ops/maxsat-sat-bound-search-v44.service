[Unit]
Description=Polish own SAT incumbents after V43 and Gurobi; test eleven unresolved V42 pairs
After=network-online.target
Wants=network-online.target
ConditionPathExists=!/home/tuyenkv/projects/sat-bound-search-v44/results/aglr/sat-bound-search-v44-20261110/COMPLETED
ConditionPathExists=!/home/tuyenkv/projects/sat-bound-search-v44/results/aglr/sat-bound-search-v44-20261110/FAILED
ConditionPathExists=!/home/tuyenkv/projects/sat-bound-search-v44/results/aglr/sat-bound-search-v44-20261110/INCOMPLETE

[Service]
Type=simple
User=tuyenkv
WorkingDirectory=/home/tuyenkv/projects/sat-bound-search-v44
EnvironmentFile=/home/tuyenkv/.config/maxsat/sat-bound-search-v44.env
ExecStart=/usr/bin/taskset -c 0,1,4,5 /bin/bash /home/tuyenkv/projects/sat-bound-search-v44/ops/run_sat_bound_search_v44.sh
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=30
RuntimeMaxSec=21600
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
